<?xml version="1.0" encoding="UTF-8"?>
<project name="QuizJars" default="jar" basedir="..">

<!-- ant -f ant/build.xml
     Makes three jars:
       dist/quiz1.jar  StudentDal  (JDBC by batch)
       dist/quiz2.jar  Vector      (generic reverse iterator)
       dist/quiz3.jar  FileDownloadUi (threaded download + UI)
-->

    <property name="src" value="src/main/java"/>
    <property name="resources" value="src/main/resources"/>
    <property name="classes" value="classes"/>
    <property name="dist" value="dist"/>
    <property name="sqlite.jar"
              location="${user.home}/.m2/repository/org/xerial/sqlite-jdbc/3.45.1.0/sqlite-jdbc-3.45.1.0.jar"/>
    <property name="slf4j.api.jar"
              location="${user.home}/.m2/repository/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar"/>
    <property name="slf4j.simple.jar"
              location="${user.home}/.m2/repository/org/slf4j/slf4j-simple/1.7.36/slf4j-simple-1.7.36.jar"/>

    <!-- ant -f ant/build.xml clean -->
    <target name="clean">
        <delete dir="${classes}"/>
        <delete dir="${dist}"/>
        <mkdir dir="${classes}"/>
        <mkdir dir="${dist}"/>
    </target>

    <!-- ant -f ant/build.xml compile -->
    <target name="compile" depends="clean">
        <javac srcdir="${src}"
               destdir="${classes}"
               includeantruntime="false"
               release="21">
            <!-- quiz answers -->
            <include name="org/example/exampractice/quiz/**/*.java"/>
            <!-- quiz1 uses jdbc.Database -->
            <include name="org/example/jdbc/Database.java"/>
        </javac>
        <copy todir="${classes}">
            <fileset dir="${resources}" includes="system.properties"/>
        </copy>
    </target>

    <!-- quiz1: StudentDal + Database + system.properties + sqlite driver -->
    <target name="jar-quiz1" depends="compile">
        <fail message="sqlite-jdbc not found. Run: mvn -q compile">
            <condition>
                <not>
                    <available file="${sqlite.jar}"/>
                </not>
            </condition>
        </fail>
        <jar destfile="${dist}/quiz1.jar">
            <fileset dir="${classes}">
                <include name="org/example/exampractice/quiz/StudentDal*.class"/>
                <include name="org/example/jdbc/Database*.class"/>
                <include name="system.properties"/>
            </fileset>
            <zipfileset src="${sqlite.jar}" excludes="META-INF/**"/>
            <zipfileset src="${slf4j.api.jar}" excludes="META-INF/**"/>
            <zipfileset src="${slf4j.simple.jar}" excludes="META-INF/**"/>
            <manifest>
                <attribute name="Main-Class" value="org.example.exampractice.quiz.StudentDal"/>
            </manifest>
        </jar>
    </target>

    <!-- quiz2: Vector -->
    <target name="jar-quiz2" depends="compile">
        <jar destfile="${dist}/quiz2.jar" basedir="${classes}">
            <include name="org/example/exampractice/quiz/Vector*.class"/>
            <manifest>
                <attribute name="Main-Class" value="org.example.exampractice.quiz.Vector"/>
            </manifest>
        </jar>
    </target>

    <!-- quiz3: FileDownloadUi -->
    <target name="jar-quiz3" depends="compile">
        <jar destfile="${dist}/quiz3.jar" basedir="${classes}">
            <include name="org/example/exampractice/quiz/FileDownloadUi*.class"/>
            <manifest>
                <attribute name="Main-Class" value="org.example.exampractice.quiz.FileDownloadUi"/>
            </manifest>
        </jar>
    </target>

    <!-- ant -f ant/build.xml   (builds all three jars) -->
    <target name="jar" depends="jar-quiz1,jar-quiz2,jar-quiz3"/>

    <!-- optional signing, same as the course notes -->
    <target name="genkey">
        <exec executable="keytool">
            <arg line="-genkeypair -alias myKey -keyalg RSA -keysize 2048 -validity 365 -keystore dist.jks"/>
        </exec>
    </target>

    <target name="sign" depends="jar">
        <exec executable="jarsigner">
            <arg line="-keystore dist.jks dist/quiz1.jar myKey"/>
        </exec>
        <exec executable="jarsigner">
            <arg line="-keystore dist.jks dist/quiz2.jar myKey"/>
        </exec>
        <exec executable="jarsigner">
            <arg line="-keystore dist.jks dist/quiz3.jar myKey"/>
        </exec>
    </target>

    <target name="verify" depends="sign">
        <exec executable="jarsigner">
            <arg line="-verify dist/quiz1.jar"/>
        </exec>
        <exec executable="jarsigner">
            <arg line="-verify dist/quiz2.jar"/>
        </exec>
        <exec executable="jarsigner">
            <arg line="-verify dist/quiz3.jar"/>
        </exec>
    </target>

</project>
